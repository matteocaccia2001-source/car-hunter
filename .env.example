# Copia questo file come .env e compila i valori
# NON caricare mai .env su GitHub

GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

SPREADSHEET_ID=il_tuo_spreadsheet_id_qui

# Notifiche — Telegram (consigliato: gratis e senza quote)
# @BotFather -> /newbot -> token; poi scrivi al bot e leggi il chat_id da
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifiche — WhatsApp via CallMeBot (fallback, il piano gratuito ha un tetto)
WHATSAPP_PHONE=
WHATSAPP_API_KEY=
